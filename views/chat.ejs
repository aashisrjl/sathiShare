<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.PNG" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SathiShare Chat – Instant Private Messaging & File Sharing</title>
    <meta
      name="description"
      content="SathiShare Chat: Secure and private instant messaging with seamless file sharing. Chat with friends and share snippets instantly."
    />
    <meta
      name="keywords"
      content="SathiShare, Sathi Share, private chat, secure messaging, instant chat, file sharing chat, Nepal chat app"
    />
    <meta property="og:title" content="SathiShare Chat – Instant Messaging" />
    <meta
      property="og:description"
      content="SathiShare: Fast and secure private chat."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZF9E6J4DB5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-ZF9E6J4DB5");
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg-base:      #0f1117;
        --bg-surface:   #161b27;
        --bg-elevated:  #1e2333;
        --bg-bubble-me: linear-gradient(135deg, #4f46e5, #7c3aed);
        --bg-bubble-other: #1e2740;
        --accent:       #6366f1;
        --accent-light: #818cf8;
        --text-primary: #e2e8f0;
        --text-muted:   #64748b;
        --border:       rgba(255,255,255,0.06);
        --shadow-lg:    0 20px 60px rgba(0,0,0,0.5);
        --radius-lg:    16px;
        --radius-bubble:18px;
      }

      html, body {
        height: 100%;
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg-base);
        color: var(--text-primary);
        overflow: hidden;
      }

      /* ── Full-screen chat layout ── */
      #chat-wrapper {
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100%;
        padding: 0;
      }

      /* ── Header ── */
      #chat-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 24px;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(10px);
        flex-shrink: 0;
      }
      #back-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--accent-light);
        font-size: 18px;
        transition: transform 0.2s, color 0.2s;
        line-height: 1;
        padding: 4px;
      }
      #back-btn:hover { transform: translateX(-3px); color: #fff; }
      .header-avatar {
        width: 40px; height: 40px;
        border-radius: 50%;
        background: var(--bg-bubble-me);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 16px;
        box-shadow: 0 0 0 2px var(--accent);
      }
      .header-info { flex: 1; }
      .header-title { font-weight: 600; font-size: 15px; }
      .header-subtitle {
        font-size: 12px; color: var(--text-muted);
        display: flex; align-items: center; gap: 5px;
      }
      .online-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 6px #22c55e;
        animation: pulse-dot 2s infinite;
      }
      @keyframes pulse-dot {
        0%,100% { opacity: 1; } 50% { opacity: .4; }
      }
      #online-count { font-size: 12px; color: var(--text-muted); }

      /* ── Messages area ── */
      #chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 20px 24px;
        background: var(--bg-surface);
        display: flex;
        flex-direction: column;
        gap: 4px;
        scroll-behavior: smooth;
      }
      #chat-messages::-webkit-scrollbar { width: 5px; }
      #chat-messages::-webkit-scrollbar-track { background: transparent; }
      #chat-messages::-webkit-scrollbar-thumb { background: #2d3748; border-radius: 10px; }

      /* Date separator */
      .date-sep {
        text-align: center;
        margin: 12px 0 6px;
        font-size: 11px;
        color: var(--text-muted);
        position: relative;
      }
      .date-sep::before, .date-sep::after {
        content: '';
        position: absolute;
        top: 50%; width: 35%; height: 1px;
        background: var(--border);
      }
      .date-sep::before { left: 0; }
      .date-sep::after { right: 0; }

      /* ── Message row ── */
      .msg-row {
        display: flex;
        gap: 8px;
        max-width: 80%;
        opacity: 0;
        animation: msgIn 0.3s ease forwards;
      }
      .msg-row.me { margin-left: auto; flex-direction: row-reverse; }
      .msg-row.them { margin-right: auto; }
      @keyframes msgIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Avatar */
      .msg-avatar {
        width: 32px; height: 32px; min-width: 32px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 13px;
        align-self: flex-end;
      }

      /* Bubble */
      .msg-bubble {
        padding: 10px 14px;
        border-radius: var(--radius-bubble);
        font-size: 14px;
        line-height: 1.55;
        word-break: break-word;
        position: relative;
      }
      .me .msg-bubble {
        background: var(--bg-bubble-me);
        border-bottom-right-radius: 4px;
        color: #fff;
        box-shadow: 0 4px 20px rgba(99,102,241,0.35);
      }
      .them .msg-bubble {
        background: var(--bg-bubble-other);
        border-bottom-left-radius: 4px;
        color: var(--text-primary);
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
      }

      /* Meta (name + time) */
      .msg-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
        font-size: 11px;
      }
      .msg-name { font-weight: 600; }
      .them .msg-name { color: var(--accent-light); }
      .me .msg-name { color: rgba(255,255,255,0.7); }
      .msg-time { color: rgba(255,255,255,0.4); font-size: 10px; }

      /* ── Code blocks ── */
      .code-block {
        background: #0d1117;
        border: 1px solid #30363d;
        border-radius: 8px;
        padding: 12px 14px;
        margin: 6px 0;
        overflow-x: auto;
        font-family: 'Fira Code', 'Cascadia Code', 'Consolas', monospace;
        font-size: 12.5px;
        line-height: 1.6;
        white-space: pre;
        color: #e6edf3;
        position: relative;
      }
      .code-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
      }
      .code-lang-badge {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #8b949e;
        font-family: 'Inter', sans-serif;
      }
      .copy-btn {
        background: rgba(255,255,255,0.08);
        border: 1px solid #30363d;
        border-radius: 4px;
        color: #8b949e;
        font-size: 10px;
        padding: 2px 8px;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        transition: background 0.2s, color 0.2s;
      }
      .copy-btn:hover { background: rgba(255,255,255,0.14); color: #e6edf3; }
      .inline-code {
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 4px;
        padding: 1px 5px;
        font-family: 'Fira Code', 'Consolas', monospace;
        font-size: 0.85em;
      }
      .chat-link { color: #93c5fd; text-decoration: underline; }
      .chat-link:hover { color: #bfdbfe; }

      /* ── Input bar ── */
      #input-bar {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        padding: 12px 24px;
        background: var(--bg-elevated);
        border-top: 1px solid var(--border);
        flex-shrink: 0;
      }
      #messageInput {
        flex: 1;
        background: var(--bg-surface);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 10px 14px;
        color: var(--text-primary);
        font-size: 14px;
        font-family: 'Inter', sans-serif;
        resize: none;
        min-height: 44px;
        max-height: 160px;
        line-height: 1.5;
        outline: none;
        transition: border-color 0.2s;
        overflow-y: auto;
      }
      #messageInput::placeholder { color: var(--text-muted); }
      #messageInput:focus { border-color: var(--accent); }
      #send-btn {
        width: 44px; height: 44px; min-width: 44px;
        border-radius: 50%;
        background: var(--accent);
        border: none;
        color: white;
        font-size: 16px;
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 14px rgba(99,102,241,0.4);
      }
      #send-btn:hover { background: #4f46e5; transform: scale(1.08); box-shadow: 0 6px 18px rgba(99,102,241,0.55); }
      #send-btn:active { transform: scale(0.96); }

      /* ── Name Modal ── */
      #nameModal {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(6px);
        z-index: 1000;
        justify-content: center;
        align-items: center;
      }
      .modal-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 36px 32px;
        width: min(90vw, 380px);
        text-align: center;
        box-shadow: var(--shadow-lg);
        animation: modalIn 0.35s cubic-bezier(.34,1.56,.64,1) forwards;
      }
      @keyframes modalIn {
        from { opacity: 0; transform: scale(0.85) translateY(20px); }
        to   { opacity: 1; transform: scale(1) translateY(0); }
      }
      .modal-icon {
        width: 64px; height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        margin: 0 auto 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 28px;
        box-shadow: 0 8px 24px rgba(99,102,241,0.4);
      }
      .modal-title {
        font-size: 22px; font-weight: 700;
        margin-bottom: 6px;
      }
      .modal-subtitle {
        font-size: 13px; color: var(--text-muted);
        margin-bottom: 24px;
      }
      #userNameInput {
        width: 100%;
        background: var(--bg-surface);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 12px 16px;
        color: var(--text-primary);
        font-size: 15px;
        font-family: 'Inter', sans-serif;
        outline: none;
        transition: border-color 0.2s;
        margin-bottom: 14px;
      }
      #userNameInput:focus { border-color: var(--accent); }
      #saveNameButton {
        width: 100%;
        padding: 12px;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        box-shadow: 0 4px 14px rgba(99,102,241,0.4);
      }
      #saveNameButton:hover { background: #4f46e5; transform: translateY(-1px); }

      /* Loading spinner overlay */
      #loadingSpinner {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 2000;
        justify-content: center;
        align-items: center;
      }
      .spinner-ring {
        width: 48px; height: 48px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,0.1);
        border-top-color: var(--accent-light);
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* Utility */
      .hidden { display: none !important; }
      /* ── Responsive Refinements ── */
      @media (max-width: 768px) {
        #chat-header { padding: 0 16px; height: 60px; }
        #chat-footer { padding: 12px 16px; }
        #chat-input-area { padding: 0 16px; gap: 12px; height: auto; min-height: 80px; padding-bottom: 20px; }
        .input-wrapper { height: 44px; }
        #messageInput { font-size: 14px; padding: 10px 14px; }
        .send-btn { width: 44px; height: 44px; font-size: 16px; }
        .msg-row { max-width: 90%; gap: 10px; }
        .msg-avatar { width: 32px; height: 32px; font-size: 12px; }
        .msg-bubble { padding: 8px 12px; font-size: 13px; }
        .user-id-badge { font-size: 10px; padding: 2px 8px; }
      }

      @media (max-width: 480px) {
        .header-left .logo-text { display: none; }
        .user-id-badge { display: none; }
      }
    </style>
  </head>

  <body>
  <%
    function formatMessageEJS(text) {
      var parts = text.split(/(```[\s\S]*?```)/g);
      return parts.map(function(part) {
        if (part.startsWith('```') && part.endsWith('```')) {
          var inner = part.slice(3, -3);
          var firstNl = inner.indexOf('\n');
          var lang = '', code = inner;
          if (firstNl > 0) {
            var possibleLang = inner.slice(0, firstNl).trim();
            if (/^[a-zA-Z0-9+#]+$/.test(possibleLang)) {
              lang = possibleLang;
              code = inner.slice(firstNl + 1);
            }
          }
          var escaped = code.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
          var header = '<div class="code-header">'
            + (lang ? '<span class="code-lang-badge">' + lang + '</span>' : '<span></span>')
            + '<button class="copy-btn" onclick="copyCode(this)">Copy</button></div>';
          return '<pre class="code-block">' + header + '<code>' + escaped + '</code></pre>';
        } else {
          var escaped = part.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
          var result = escaped.replace(/`([^`\n]+)`/g, '<code class="inline-code">$1</code>');
          result = result.replace(/https?:\/\/[^\s<>"']+/g, function(url){ return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="chat-link">' + url + '</a>'; });
          result = result.replace(/\n/g, '<br>');
          return result;
        }
      }).join('');
    }

    // Avatar colour palette
    var AVATAR_COLORS = [
      'linear-gradient(135deg,#4f46e5,#7c3aed)',
      'linear-gradient(135deg,#0891b2,#0e7490)',
      'linear-gradient(135deg,#059669,#047857)',
      'linear-gradient(135deg,#d97706,#b45309)',
      'linear-gradient(135deg,#dc2626,#b91c1c)',
      'linear-gradient(135deg,#db2777,#be185d)',
    ];
    function avatarColor(name) {
      var idx = 0;
      if (name) { for (var i=0; i<name.length; i++) idx += name.charCodeAt(i); }
      return AVATAR_COLORS[idx % AVATAR_COLORS.length];
    }
    function fmtTime(d) {
      var h = d.getHours(), m = d.getMinutes(), ap = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return h + ':' + (m < 10 ? '0' : '') + m + ' ' + ap;
    }
  %>

    <!-- Loading overlay -->
    <div id="loadingSpinner">
      <div class="spinner-ring"></div>
    </div>

    <!-- Name Modal -->
    <div id="nameModal">
      <div class="modal-card">
        <div class="modal-icon">💬</div>
        <h2 class="modal-title">What's your name?</h2>
        <p class="modal-subtitle">This is how others will see you in the chat.</p>
        <input type="text" id="userNameInput" placeholder="Enter your name…" maxlength="30" />
        <button id="saveNameButton">Join Chat</button>
      </div>
    </div>

    <!-- Chat wrapper -->
    <div id="chat-wrapper">

      <!-- Header -->
      <div id="chat-header">
        <button id="back-btn" onclick="window.location.href='/'">
          <i class="fas fa-arrow-left"></i>
        </button>
        <div class="header-avatar">💬</div>
        <div class="header-info">
          <div class="header-title">SathiShare Chat</div>
          <div class="header-subtitle">
            <span class="online-dot"></span>
            <span id="online-count">Live • messages auto-delete in 10 min</span>
          </div>
        </div>
      </div>

      <!-- Messages -->
      <div id="chat-messages">
        <% msgg.forEach(function(msg, index) {
          var isMe = msg.ipAddress === clientIp;
          var initial = msg.userName ? msg.userName.charAt(0).toUpperCase() : '?';
          var color = avatarColor(msg.userName);
          var timeStr = msg.createdAt ? fmtTime(new Date(msg.createdAt)) : '';
        %>
        <div class="msg-row <%= isMe ? 'me' : 'them' %>" style="animation-delay:<%= index * 0.05 %>s">
          <div class="msg-avatar" style="background:<%= color %>"><%= initial %></div>
          <div>
            <div class="msg-meta">
              <span class="msg-name"><%= msg.userName || 'Unknown' %></span>
              <% if (timeStr) { %><span class="msg-time"><%= timeStr %></span><% } %>
            </div>
            <div class="msg-bubble"><%- formatMessageEJS(msg.message) %></div>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Input bar -->
      <form id="input-bar">
        <textarea
          id="messageInput"
          placeholder="Type a message… (Shift+Enter for new line)"
          rows="1"
        ></textarea>
        <button type="submit" id="send-btn">
          <i class="fas fa-paper-plane"></i>
        </button>
      </form>

    </div><!-- /chat-wrapper -->

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const socket = io();

      // ── Avatar colours (mirrors server-side) ──
      const AVATAR_COLORS = [
        'linear-gradient(135deg,#4f46e5,#7c3aed)',
        'linear-gradient(135deg,#0891b2,#0e7490)',
        'linear-gradient(135deg,#059669,#047857)',
        'linear-gradient(135deg,#d97706,#b45309)',
        'linear-gradient(135deg,#dc2626,#b91c1c)',
        'linear-gradient(135deg,#db2777,#be185d)',
      ];
      function avatarColor(name) {
        let idx = 0;
        if (name) for (let i = 0; i < name.length; i++) idx += name.charCodeAt(i);
        return AVATAR_COLORS[idx % AVATAR_COLORS.length];
      }
      function fmtTime(d) {
        let h = d.getHours(), m = d.getMinutes(), ap = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return `${h}:${m < 10 ? '0' : ''}${m} ${ap}`;
      }

      // ── Message formatter ──
      function formatMessage(text) {
        const parts = text.split(/(```[\s\S]*?```)/g);
        return parts.map(part => {
          if (part.startsWith('```') && part.endsWith('```')) {
            const inner = part.slice(3, -3);
            const firstNl = inner.indexOf('\n');
            let lang = '', code = inner;
            if (firstNl > 0) {
              const pl = inner.slice(0, firstNl).trim();
              if (/^[a-zA-Z0-9+#]+$/.test(pl)) { lang = pl; code = inner.slice(firstNl + 1); }
            }
            const escaped = code.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            const header = `<div class="code-header"><span class="code-lang-badge">${lang}</span><button class="copy-btn" onclick="copyCode(this)">Copy</button></div>`;
            return `<pre class="code-block">${header}<code>${escaped}</code></pre>`;
          } else {
            let escaped = part.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            escaped = escaped.replace(/`([^`\n]+)`/g, '<code class="inline-code">$1</code>');
            escaped = escaped.replace(/https?:\/\/[^\s<>"']+/g, url => `<a href="${url}" target="_blank" rel="noopener noreferrer" class="chat-link">${url}</a>`);
            return escaped.replace(/\n/g, '<br>');
          }
        }).join('');
      }

      // ── Copy code helper ──
      function copyCode(btn) {
        const code = btn.closest('.code-block').querySelector('code').innerText;
        navigator.clipboard.writeText(code).then(() => {
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });
      }

      // ── DOM refs ──
      const messageInput  = document.getElementById('messageInput');
      const form          = document.getElementById('input-bar');
      const chatMessages  = document.getElementById('chat-messages');
      const nameModal     = document.getElementById('nameModal');
      const userNameInput = document.getElementById('userNameInput');
      const saveNameButton= document.getElementById('saveNameButton');
      let clientSocketId;
      let userName = localStorage.getItem('userName');

      // ── Modal logic ──
      if (!userName) {
        nameModal.style.display = 'flex';
        setTimeout(() => userNameInput.focus(), 300);
      }
      userNameInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); saveNameButton.click(); }
      });
      saveNameButton.addEventListener('click', () => {
        const val = userNameInput.value.trim();
        if (!val) { userNameInput.style.borderColor = '#ef4444'; return; }
        userName = val;
        localStorage.setItem('userName', userName);
        nameModal.style.display = 'none';
        // patch any "Unknown" labels on user's own messages
        document.querySelectorAll('.msg-row.me .msg-name').forEach(el => {
          if (el.textContent === 'Unknown') el.textContent = userName;
        });
        document.querySelectorAll('.msg-row.me .msg-avatar').forEach(el => {
          el.textContent = userName.charAt(0).toUpperCase();
          el.style.background = avatarColor(userName);
        });
      });

      // ── Socket ──
      socket.on('connect', () => { clientSocketId = socket.id; });

      // ── Textarea auto-resize ──
      messageInput.addEventListener('input', () => {
        messageInput.style.height = 'auto';
        messageInput.style.height = messageInput.scrollHeight + 'px';
      });
      messageInput.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          form.dispatchEvent(new Event('submit'));
        }
      });

      // ── Send message ──
      function sendMessage() {
        const text = messageInput.value.replace(/^\s+|\s+$/g, '');
        if (!text) return;
        socket.emit('message', { message: text, socketId: clientSocketId, userName });
        messageInput.value = '';
        messageInput.style.height = 'auto';
      }
      form.addEventListener('submit', e => { e.preventDefault(); sendMessage(); });

      // ── Build message element ──
      function buildMsgEl(msg, isMe) {
        const row = document.createElement('div');
        row.className = `msg-row ${isMe ? 'me' : 'them'}`;

        const avatar = document.createElement('div');
        avatar.className = 'msg-avatar';
        avatar.style.background = avatarColor(msg.userName);
        avatar.textContent = msg.userName ? msg.userName.charAt(0).toUpperCase() : '?';

        const inner = document.createElement('div');

        const meta = document.createElement('div');
        meta.className = 'msg-meta';
        const name = document.createElement('span');
        name.className = 'msg-name';
        name.textContent = msg.userName || 'Unknown';
        const time = document.createElement('span');
        time.className = 'msg-time';
        time.textContent = fmtTime(new Date());
        meta.append(name, time);

        const bubble = document.createElement('div');
        bubble.className = 'msg-bubble';
        bubble.innerHTML = formatMessage(msg.message);

        inner.append(meta, bubble);
        row.append(avatar, inner);
        return row;
      }

      // ── Receive broadcast ──
      socket.on('broadcast', msg => {
        const isMe = msg.socketId === clientSocketId;
        const el = buildMsgEl(msg, isMe);
        chatMessages.appendChild(el);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      });

      // ── Initial scroll to bottom ──
      chatMessages.scrollTop = chatMessages.scrollHeight;
    </script>
  </body>
</html>
