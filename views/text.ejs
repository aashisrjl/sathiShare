<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.PNG" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SathiShare – Code</title>
    <meta
      name="description"
      content="SathiShare lets you share code snippets easily — a simple and fast sharing platform built with Node.js."
    />
    <meta
      name="keywords"
      content="file sharing, chat app, text sharing, SathiShare, Node.js, Nepal"
    />
    <meta property="og:title" content="SathiShare – Chat & Share Instantly" />
    <meta
      property="og:description"
      content="Fast and free file & text sharing app from Nepal."
    />
    <meta property="og:url" content="https://sathishare.aashishrijal.com.np" />
    <meta property="og:type" content="website" />

    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes fadeInScale {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
      }
      .fade-in-scale {
        animation: fadeInScale 0.6s ease-out forwards;
      }
    </style>
  </head>
  <body class="bg-gray-900 text-gray-200 font-sans min-h-screen flex flex-col">
    <div class="container mx-auto px-4 py-6 flex-1">
      <div
        class="loading-spinner hidden fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-gray-800 rounded-full w-12 h-12 border-4 border-t-blue-400 border-b-blue-400 animate-spin"
        id="loadingSpinner"
      ></div>

      <!-- Form with Animation -->
      <form action="/text/post/" method="post" class="max-w-2xl mx-auto">
        <!-- Header with Animation -->
        <div
          class="header flex justify-between items-center mb-8 fade-in-up delay-100"
        >
          <input
            type="text"
            name="title"
            id="title"
            placeholder="Enter a title"
            required
            class="bg-gray-800 text-lg font-semibold p-2 rounded-lg w-2/3 outline-none text-gray-200"
          />
          <a
            href="/"
            class="text-blue-400 hover:text-blue-300 bg-red-600 p-2 rounded-md transition duration-300 flex items-center"
            style="text-decoration: none"
          >
            <span>Cancel</span> <i class="fas fa-times ml-2"></i>
          </a>
        </div>

        <!-- Textarea with Animation -->
        <div class="textarea mb-12 fade-in-scale delay-200">
          <textarea
            name="text"
            cols="5"
            rows="25"
            placeholder="Enter or paste your text/code here .... "
            required
            class="w-full bg-gray-800 text-gray-200 p-4 rounded-lg shadow-md outline-none resize-none font-mono text-sm"
          ></textarea>
        </div>

        <!-- Footer with Buttons -->
        <footer class="flex justify-end space-x-4 mb-12 fade-in-up delay-300">
          <button
            type="submit"
            class="bg-blue-600 text-white px-6 py-3 rounded-lg shadow-md hover:bg-blue-700 hover:scale-105 transition duration-300 ease-in-out"
          >
            Share
          </button>
          <a
            href="/text/post/"
            class="bg-green-600 text-white px-6 py-3 rounded-lg shadow-md hover:bg-green-700 hover:scale-105 transition duration-300 ease-in-out text-center inline-block"
            style="text-decoration: none"
            >New</a
          >
        </footer>
      </form>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-gray-400 text-center py-6 mt-auto">
      <p>© 2025 SathiShare. All rights reserved.</p>
    </footer>

    <script src="/script/loader.js"></script>
    <%- include('component/messageBox') %>
    <script>
      const msgBox = document.querySelector(".msg");
      if (msgBox) {
        setTimeout(() => {
          msgBox.remove();
        }, 3000);
      }

      document.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          document.getElementById("loadingSpinner").classList.remove("hidden");
        });
      });
    </script>
  </body>
</html>
