<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.PNG" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SathiShare – Email</title>
    <meta
      name="description"
      content="SathiShare lets you Email files easily — a simple and fast sharing platform built with Node.js."
    />
    <meta
      name="keywords"
      content="file sharing, chat app, text sharing, SathiShare, Node.js, Nepal"
    />
    <meta property="og:title" content="SathiShare – Chat & Share Instantly" />
    <meta
      property="og:description"
      content="Fast and free file & text sharing app from Nepal."
    />
    <meta property="og:url" content="https://sathishare.aashishrijal.com.np" />
    <meta property="og:type" content="website" />

    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes fadeInScale {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
      }
      .fade-in-scale {
        animation: fadeInScale 0.6s ease-out forwards;
      }
      .home-link {
        position: absolute;
        top: 20px;
        right: 20px;
      }
    </style>
  </head>
  <body class="bg-gray-900 text-gray-200 font-sans min-h-screen flex flex-col">
    <div
      class="container mx-auto px-4 py-6 flex-grow flex items-center justify-center"
    >
      <div
        class="loading-spinner hidden fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-gray-800 rounded-full w-12 h-12 border-4 border-t-blue-400 border-b-blue-400 animate-spin"
        id="loadingSpinner"
      ></div>

      <!-- Form Container with Animation -->
      <div
        class="max-w-md mx-auto bg-gray-800 p-6 rounded-lg shadow-lg fade-in-up delay-100"
      >
        <legend
          class="text-2xl font-bold text-blue-400 mb-4 fade-in-up delay-200"
        >
          Send File
        </legend>
        <a
          href="/"
          class="home-link text-blue-400 hover:text-blue-300 transition duration-300 flex items-center fade-in-up delay-300"
        >
          <i class="fas fa-home mr-2"></i>
          <span class="text-lg">Home</span>
        </a>
        <h2 class="text-xl text-gray-300 mb-4 mt-6 fade-in-up delay-400">
          Enter your email
        </h2>
        <form action="/file/send/<%= file %>" method="post" class="space-y-4">
          <input
            type="email"
            name="email"
            id="email"
            placeholder="example@gmail.com"
            required
            class="w-full bg-gray-700 text-gray-200 p-3 rounded-lg outline-none focus:ring-2 focus:ring-blue-500 transition duration-300"
          />
          <button
            type="submit"
            class="w-full bg-blue-600 text-white p-3 rounded-lg shadow-md hover:bg-blue-700 hover:scale-105 transition duration-300 ease-in-out fade-in-scale delay-500"
          >
            Send
          </button>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-gray-400 text-center py-6 mt-auto w-full">
      <p>© 2025 SathiShare. All rights reserved.</p>
    </footer>

    <script src="/script/loader.js"></script>
    <%- include('component/messageBox') %>
    <script>
      const msgBox = document.querySelector(".msg");
      if (msgBox) {
        setTimeout(() => {
          msgBox.remove();
        }, 3000);
      }

      document.querySelectorAll("a, button").forEach((element) => {
        element.addEventListener("click", () => {
          document.getElementById("loadingSpinner").classList.remove("hidden");
        });
      });
    </script>
  </body>
</html>
