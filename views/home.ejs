<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.PNG" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SathiShare – Fast, Secure & Instant File and Code Sharing</title>
    <meta
      name="description"
      content="SathiShare is the fastest way to share files, code snippets, and chat with friends instantly. A simple, secure, and private sharing platform built for speed."
    />
    <meta
      name="keywords"
      content="SathiShare, Sathi Share, file sharing, code sharing, instant chat, private sharing, Node.js app, Nepal sharing platform, fast file transfer"
    />
    <meta property="og:title" content="SathiShare – Chat & Share Instantly" />
    <meta
      property="og:description"
      content="SathiShare: Fast, free, and secure file & text sharing app."
    />
    <meta property="og:url" content="https://sathishare.aashishrijal.com.np" />
    <meta property="og:type" content="website" />
    <link href="/css/style.css" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <style>
      /* Custom animations using Tailwind and vanilla CSS */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes bounceIn {
        0%,
        20%,
        50%,
        80%,
        100% {
          transform: translateY(0);
        }
        40% {
          transform: translateY(-10px);
        }
        60% {
          transform: translateY(-5px);
        }
      }
      .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
      }
      .bounce-in {
        animation: bounceIn 1.5s ease-in-out infinite;
      }

      /* Premium Floating Menu Styles */
      .floating-menu {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1000;
        font-family: 'Inter', sans-serif;
      }
      .menu-btn {
        background: rgba(59, 130, 246, 0.2);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 10px 20px;
        border-radius: 99px;
        color: white;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }
      .menu-btn:hover {
        background: rgba(59, 130, 246, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.3);
        border-color: rgba(255, 255, 255, 0.2);
      }
      .menu-dropdown {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        width: 180px;
        background: rgba(31, 41, 55, 0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 8px;
        display: none;
        flex-direction: column;
        gap: 4px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
        transform: translateY(10px);
        opacity: 0;
        transition: all 0.3s ease;
      }
      .menu-dropdown.show {
        display: flex;
        transform: translateY(0);
        opacity: 1;
      }
      .menu-item {
        padding: 12px 16px;
        border-radius: 10px;
        color: #d1d5db;
        text-decoration: none;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s ease;
      }
      .menu-item:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
      }
      .menu-item i {
        width: 16px;
        color: #60a5fa;
      }

    </style>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ZF9E6J4DB5"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-ZF9E6J4DB5");
    </script>
  </head>
  <body class="bg-gray-900 font-sans min-h-screen flex flex-col">
    <div class="container mx-auto px-4 py-6 flex-1">
      <div
        class="loading-spinner hidden fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-gray-800 rounded-full w-12 h-12 border-4 border-t-blue-400 border-b-blue-400 animate-spin"
        id="loadingSpinner"
      ></div>
      <!-- Premium Floating Menu -->
      <div class="floating-menu fade-in-up">
        <button class="menu-btn" id="menuBtn">
          <i class="fas fa-folder-open"></i>
          <span>My Shares</span>
          <i class="fas fa-chevron-down text-xs transition-transform duration-300" id="menuChevron"></i>
        </button>
        <div class="menu-dropdown" id="menuDropdown">
          <a href="/mytexts" class="menu-item">
            <i class="fas fa-code"></i>
            <span>My Texts</span>
          </a>
          <a href="/myfiles" class="menu-item">
            <i class="fas fa-file-alt"></i>
            <span>My Files</span>
          </a>
        </div>
      </div>

      <!-- Centered Logo with Animation -->
      <div class="text-center mb-10 mt-12">
        <div class="logo inline-block fade-in-up delay-100">
          <span class="text-blue-600 text-4xl font-extrabold">
            ---|| Sathi <span class="text-white"> Share ||---</span></span
          >
        </div>
      </div>
      <!-- button to get all my share files or texts -->


      

      <!-- Search Bar with Animation -->
      <div class="search-container w-full max-w-xl mx-auto mb-8">
        <div
          class="search-box flex items-center bg-gray-800 rounded-lg shadow-md p-2 fade-in-up delay-200"
        >
          <input
            id="search"
            type="text"
            placeholder="Search..."
            class="w-full outline-none text-sm bg-transparent text-gray-200"
            onkeypress="if(event.key === 'Enter') window.location.href=`/search/${this.value}`"
          />
          <i
            class="fas fa-search text-gray-400 cursor-pointer ml-2"
            onclick="window.location.href=`/search/${document.getElementById('search').value}`"
          ></i>
        </div>
      </div>

      <!-- Main Content -->
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-blue-400 mb-4 fade-in-up delay-300">
          Welcome to SathiShare
        </h1>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto fade-in-up delay-400">
          Share photos, videos, and files, or start chatting with friends. No
          login required; just enter your name and start connecting!
        </p>
      </header>

      <div class="logo-container mb-12">
        <div
          class="buttons-wrapper grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto"
        >
          <div
            class="button bg-blue-600 text-white p-4 rounded-lg shadow-md hover:bg-blue-700 hover:scale-105 transition duration-300 ease-in-out text-center cursor-pointer fade-in-up delay-500"
            onclick="window.location.href='/text/post/'"
          >
            Share Code
          </div>
          <div
            class="button bg-green-600 text-white p-4 rounded-lg shadow-md hover:bg-green-700 hover:scale-105 transition duration-300 ease-in-out text-center cursor-pointer fade-in-up delay-600"
            onclick="document.getElementById('fileInput').click()"
          >
            Share Files
          </div>
          <div
            class="button bg-purple-600 text-white p-4 rounded-lg shadow-md hover:bg-purple-700 hover:scale-105 transition duration-300 ease-in-out text-center cursor-pointer fade-in-up delay-700"
            onclick="window.location.href='/chat'"
          >
            Start Chat
          </div>
        </div>
      </div>

      <!-- Hidden form for file upload -->
      <form
        id="fileForm"
        action="/file"
        method="post"
        enctype="multipart/form-data"
        class="hidden"
      >
        <input
          type="file"
          id="fileInput"
          name="file"
          class="hidden-input"
          onchange="submitForm()"
          multiple
        />
      </form>

      <!-- Social Links with Animation -->
      <div class="social-links text-center mb-12">
        <div class="social-links-container inline-flex space-x-6">
          <a
            href="https://www.linkedin.com/in/aashis-rijal-190402276"
            target="_blank"
            class="social-link text-blue-400 hover:text-blue-300 transition duration-300 bounce-in"
            style="animation-delay: 0.1s"
            ><i class="fab fa-linkedin"></i
          ></a>
          <a
            href="https://www.facebook.com/aashis.rijal.92"
            target="_blank"
            class="social-link text-blue-400 hover:text-blue-300 transition duration-300 bounce-in"
            style="animation-delay: 0.2s"
            ><i class="fab fa-facebook-f"></i
          ></a>
          <a
            href="https://github.com/aashisrjl"
            target="_blank"
            class="social-link text-gray-300 hover:text-gray-400 transition duration-300 bounce-in"
            style="animation-delay: 0.3s"
            ><i class="fab fa-github"></i
          ></a>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-gray-400 text-center py-6 mt-auto">
      <p>© 2025 SathiShare. All rights reserved.</p>
    </footer>
    <script>
      const menuBtn = document.getElementById('menuBtn');
      const menuDropdown = document.getElementById('menuDropdown');
      const menuChevron = document.getElementById('menuChevron');

      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isShowing = menuDropdown.classList.toggle('show');
        menuChevron.style.transform = isShowing ? 'rotate(180deg)' : 'rotate(0deg)';
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!menuBtn.contains(e.target) && !menuDropdown.contains(e.target)) {
          menuDropdown.classList.remove('show');
          menuChevron.style.transform = 'rotate(0deg)';
        }
      });
    </script>

    <script>
      function submitForm() {
        document.getElementById("loadingSpinner").classList.remove("hidden");
        document.getElementById("fileForm").submit();
      }
    </script>
    <script src="/script/loader.js"></script>
    <%- include('component/messageBox') %>
    <script>
      const msgBox = document.querySelector(".msg");
      if (msgBox) {
        setTimeout(() => {
          msgBox.remove();
        }, 3000);
      }
    </script>

  </body>
</html>
