<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.PNG" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SathiShare – Files</title>
    <meta
      name="description"
      content="SathiShare lets you share files easily — a simple and fast sharing platform built with Node.js."
    />
    <meta
      name="keywords"
      content="file sharing, chat app, text sharing, SathiShare, Node.js, Nepal"
    />
    <meta property="og:title" content="SathiShare – Chat & Share Instantly" />
    <meta
      property="og:description"
      content="Fast and free file & text sharing app from Nepal."
    />
    <meta property="og:url" content="https://sathishare.aashishrijal.com.np" />
    <meta property="og:type" content="website" />

    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <style>
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes fadeInScale {
        from {
          opacity: 0;
          transform: scale(0.95);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
      }
      .fade-in-item {
        animation: fadeInUp 0.5s ease-out forwards;
      }
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        z-index: 50;
        justify-content: center;
        align-items: center;
      }
      .modal-content {
        background-color: #1f2937;
        padding: 20px;
        border-radius: 10px;
        max-width: 90%;
        max-height: 90vh;
        overflow: auto;
        position: relative;
        animation: fadeInScale 0.3s ease-out;
      }
      .modal-content img {
        max-width: 100%;
        max-height: 80vh;
        display: block;
        margin: 0 auto;
      }
      .close-modal {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 24px;
        color: #fff;
        cursor: pointer;
        transition: color 0.3s;
      }
      .close-modal:hover {
        color: #ef4444;
      }
    </style>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ZF9E6J4DB5"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-ZF9E6J4DB5");
    </script>
  </head>
  <body class="bg-gray-900 text-gray-200 font-sans min-h-screen flex flex-col">
    <div class="container mx-auto px-4 py-6 flex-1">
      <div
        class="loading-spinner hidden fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-gray-800 rounded-full w-12 h-12 border-4 border-t-blue-400 border-b-blue-400 animate-spin"
        id="loadingSpinner"
      ></div>

      <!-- Header with Animation -->
      <div
        class="header flex justify-between items-center mb-8 fade-in-up delay-100"
      >
        <i
          onclick="window.location.href='/'"
          class="fas fa-arrow-left cursor-pointer text-blue-400 text-2xl hover:text-blue-300 transition duration-300"
        ></i>
        <h3 class="text-xl font-semibold">
          Files: <span class="text-blue-400"><%= userId %></span>
        </h3>
        <div></div>
        <!-- Placeholder to balance flex layout -->
      </div>

      <h1
        class="text-3xl font-bold text-white text-center mb-8 fade-in-up delay-200"
      >
        Keep Sharing Guys 😁😎
      </h1>

      <!-- File List -->
      <div class="mb-12">
        <% if (files.length > 0) { %>
        <ul class="file-list space-y-4 max-w-2xl mx-auto">
          <% files.forEach((file, index) => { %>
          <li
            class="fade-in-item delay-<%= index * 100 %>"
            style="animation-delay: <%= index * 0.1 %>s"
          >
            <div
              class="bg-gray-800 p-4 rounded-lg shadow-md flex justify-between items-center"
            >
              <span
                class="text-lg cursor-pointer text-blue-400 hover:text-blue-300 transition duration-300"
                onclick="openModal('/storage/<%= file.file %>', '<%= file.file %>')"
                ><%= file.file %></span
              >
              <div class="space-x-4">
                <a
                  href="/storage/<%= file.file %>"
                  class="copy-link text-green-400 hover:text-green-300 transition duration-300"
                  download
                  ><i class="fas fa-download"></i
                ></a>
                <a
                  href="/file/email/<%= file.file %>"
                  target="_blank"
                  class="visit-link text-blue-400 hover:text-blue-300 transition duration-300"
                  ><i class="fas fa-envelope"></i
                ></a>
                <a
                  href="/file/delete/<%= file._id %>"
                  class="visit-link text-red-400 hover:text-red-300 transition duration-300 rounded-full w-8 h-8 flex items-center justify-center"
                  style="background-color: red; color: white"
                  ><i class="fas fa-times"></i
                ></a>
              </div>
            </div>
          </li>
          <% }); %>
        </ul>
        <% } else { %>
        <p class="text-center text-gray-400">
          No files found for this user ID.
        </p>
        <% } %>
      </div>

      <!-- Share Another Button -->
      <div class="text-center mb-12">
        <ul class="inline-flex space-x-4">
          <li class="new">
            <p
              onclick="document.getElementById('fileInput').click()"
              class="bg-blue-600 text-white px-6 py-3 rounded-lg shadow-md hover:bg-blue-700 hover:scale-105 transition duration-300 ease-in-out cursor-pointer"
            >
              Share Another
            </p>
          </li>
        </ul>
      </div>

      <!-- Hidden Form for File Upload -->
      <form
        id="fileForm"
        action="/file"
        method="post"
        enctype="multipart/form-data"
        class="hidden"
      >
        <input
          type="file"
          id="fileInput"
          name="file"
          class="hidden-input"
          onchange="submitForm()"
          multiple
        />
      </form>

      <!-- Modal -->
      <div id="fileModal" class="modal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
          <span class="close-modal" onclick="closeModal()">&times;</span>
          <img id="modalImage" src="" alt="File Preview" />
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-800 text-gray-400 text-center py-6 mt-auto">
      <p>© 2025 SathiShare. All rights reserved.</p>
    </footer>

    <script src="/script/loader.js"></script>
    <%- include('component/messageBox') %>
    <script>
      const msgBox = document.querySelector(".msg");
      if (msgBox) {
        setTimeout(() => {
          msgBox.remove();
        }, 3000);
      }

      function submitForm() {
        document.getElementById("loadingSpinner").classList.remove("hidden");
        document.getElementById("fileForm").submit();
      }

      document.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          document.getElementById("loadingSpinner").classList.remove("hidden");
        });
      });

      function openModal(imageUrl, fileName) {
        const extension = fileName.split(".").pop().toLowerCase();
        const imageExtensions = ["png", "jpg", "jpeg", "gif"];
        if (imageExtensions.includes(extension)) {
          const modal = document.getElementById("fileModal");
          const modalImage = document.getElementById("modalImage");
          modalImage.src = imageUrl;
          modal.style.display = "flex";
        } else {
          // For non-image files, trigger download (handled by the href)
          window.location.href = imageUrl;
        }
      }

      function closeModal(event) {
        const modal = document.getElementById("fileModal");
        modal.style.display = "none";
      }
    </script>
  </body>
</html>
