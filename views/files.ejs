<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/img/logo.PNG" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SathiShare – Shared Files: <%= userId %></title>
    <meta
      name="description"
      content="SathiShare: Access and manage your shared files using ID <%= userId %>. Fast and secure file sharing for free."
    />
    <meta
      name="keywords"
      content="SathiShare, Sathi Share, shared files, file management, instant sharing, secure files, <%= userId %>"
    />
    <meta property="og:title" content="SathiShare – Shared Files" />
    <meta
      property="og:description"
      content="SathiShare: Fast and secure file sharing."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZF9E6J4DB5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-ZF9E6J4DB5");
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg-base:      #0f1117;
        --bg-surface:   #161b27;
        --bg-elevated:  #1e2333;
        --accent:       #3b82f6;
        --accent-glow:  rgba(59, 130, 246, 0.5);
        --text-primary: #e2e8f0;
        --text-muted:   #94a3b8;
        --border:       rgba(255, 255, 255, 0.08);
        --radius-lg:    20px;
        --radius-md:    12px;
      }

      html, body {
        height: 100%;
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg-base);
        color: var(--text-primary);
        line-height: 1.5;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px;
      }

      /* ── Header ── */
      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 48px;
        animation: fadeInDown 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .back-btn {
        width: 44px; height: 44px;
        border-radius: 50%;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        color: var(--accent);
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
      }
      .back-btn:hover {
        background: var(--accent);
        color: white;
        transform: translateX(-4px);
        box-shadow: 0 0 20px var(--accent-glow);
      }
      .user-id-badge {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.2);
        padding: 6px 16px;
        border-radius: 99px;
        color: var(--accent);
        font-weight: 600;
        font-size: 14px;
      }

      /* ── Hero ── */
      .hero {
        text-align: center;
        margin-bottom: 64px;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s backwards;
      }
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .hero h1 {
        font-size: 42px; font-weight: 800;
        margin-bottom: 12px;
        background: linear-gradient(to right, #fff, #94a3b8);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .hero p { color: var(--text-muted); font-size: 18px; }

      /* ── File Grid ── */
      .file-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 64px;
      }

      .file-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        gap: 16px;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(10px);
        animation: scaleIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      }
      @keyframes scaleIn {
        from { opacity: 0; transform: scale(0.9); }
        to   { opacity: 1; transform: scale(1); }
      }
      .file-card:hover {
        transform: translateY(-8px) scale(1.02);
        border-color: rgba(59, 130, 246, 0.4);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
      }
      .file-card::before {
        content: '';
        position: absolute; top: 0; left: 0; width: 100%; height: 4px;
        background: var(--accent);
        opacity: 0; transition: opacity 0.3s;
      }
      .file-card:hover::before { opacity: 1; }

      .file-icon {
        width: 56px; height: 56px;
        background: rgba(255,255,255,0.03);
        border-radius: var(--radius-md);
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
        color: var(--accent);
        transition: transform 0.3s ease;
      }
      .file-card:hover .file-icon {
        transform: rotate(-10deg) scale(1.1);
        background: rgba(59, 130, 246, 0.1);
      }

      .file-info { flex: 1; }
      .file-name {
        font-weight: 600; font-size: 16px;
        word-break: break-all;
        margin-bottom: 4px;
        display: -webkit-box;
        line-clamp: 2;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .file-meta { font-size: 13px; color: var(--text-muted); }

      .file-actions {
        display: flex;
        gap: 10px;
        margin-top: 8px;
      }
      .action-btn {
        flex: 1;
        height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        gap: 8px;
      }
      .btn-download { background: var(--accent); color: white; }
      .btn-download:hover { background: #2563eb; transform: translateY(-2px); }
      .btn-email { background: rgba(255,255,255,0.05); color: white; border: 1px solid var(--border); }
      .btn-email:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); }
      .btn-delete {
        width: 40px; min-width: 40px;
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
      }
      .btn-delete:hover { background: #ef4444; color: white; }

      /* ── Empty State ── */
      .empty-state {
        text-align: center;
        padding: 80px 0;
        color: var(--text-muted);
      }
      .empty-icon { font-size: 64px; margin-bottom: 24px; opacity: 0.3; }

      /* ── Action Bar ── */
      .action-bar {
        text-align: center;
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
      }
      .btn-primary {
        background: var(--accent);
        color: white;
        padding: 14px 32px;
        border-radius: 99px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        display: inline-flex; align-items: center; gap: 10px;
        transition: all 0.3s;
        border: none;
        box-shadow: 0 10px 30px var(--accent-glow);
      }
      .btn-primary:hover {
        transform: translateY(-4px) scale(1.05);
        background: #2563eb;
        box-shadow: 0 15px 40px var(--accent-glow);
      }

      /* ── Modal ── */
      .modal {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(8px);
        z-index: 2000;
        padding: 40px;
        justify-content: center; align-items: center;
      }
      .modal-content {
        max-width: 90%; max-height: 90%;
        position: relative;
        animation: modalIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes modalIn {
        from { opacity: 0; transform: scale(0.95); }
        to   { opacity: 1; transform: scale(1); }
      }
      .modal-content img {
        display: block; width: auto; height: auto;
        max-width: 100%; max-height: 80vh;
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.8);
      }
      .close-modal {
        position: absolute; top: -50px; right: 0;
        color: white; font-size: 32px; cursor: pointer;
        transition: opacity 0.2s;
      }
      .close-modal:hover { opacity: 0.7; }

      /* ── Footer ── */
      footer {
        padding: 48px 0;
        text-align: center;
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 14px;
      }

      /* Loading spinner */
      #loadingSpinner {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.7);
        z-index: 3000;
        justify-content: center; align-items: center;
      }
      .spinner {
        width: 50px; height: 50px;
        border: 4px solid rgba(255,255,255,0.1);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* ── Responsive Refinements ── */
      @media (max-width: 768px) {
        .container { padding: 0 16px; }
        .hero h1 { font-size: 32px; }
        .hero p { font-size: 14px; }
        .file-grid { grid-template-columns: 1fr; gap: 16px; }
        .file-card { padding: 16px; }
        .file-icon { width: 44px; height: 44px; font-size: 20px; }
        .file-name { font-size: 15px; }
        .btn-primary { width: 100%; justify-content: center; }
      }

      .hidden { display: none !important; }
    </style>
  </head>

  <body>
    <div id="loadingSpinner">
      <div class="spinner"></div>
    </div>

    <div class="container">
      <header class="header">
        <a href="/" class="back-btn">
          <i class="fas fa-arrow-left"></i>
        </a>
        <div class="user-id-badge">
          ID: <%= userId %>
        </div>
        <div></div>
      </header>

      <section class="hero">
        <h1>Your Shared Files</h1>
        <p>Manage and share your files effortlessly.</p>
      </section>

      <div class="file-grid">
        <% if (files.length > 0) { %>
          <% files.forEach((file, index) => {
               const fileName = file.file.split('/').pop();
               const ext = fileName.includes('.') ? fileName.split('.').pop().toLowerCase() : '';
               let iconClass = 'fa-file';
               if (['jpg', 'jpeg', 'png', 'gif', 'svg'].includes(ext)) iconClass = 'fa-file-image';
               else if (['mp4', 'webm', 'mov'].includes(ext)) iconClass = 'fa-file-video';
               else if (['pdf'].includes(ext)) iconClass = 'fa-file-pdf';
               else if (['zip', 'rar', '7z'].includes(ext)) iconClass = 'fa-file-archive';
               else if (['js', 'html', 'css', 'py', 'json'].includes(ext)) iconClass = 'fa-file-code';
          %>
          <div class="file-card" style="animation-delay: <%= index * 0.05 %>s">
            <div class="file-icon">
              <i class="fas <%= iconClass %>"></i>
            </div>
            <div class="file-info">
              <div class="file-name" onclick="openPreview('<%= file.file %>', '<%= file.file %>')" style="cursor: pointer;"><%= file.file.split('/').pop() %></div>
              <div class="file-meta">Click name to preview</div>
            </div>
            <div class="file-actions">
              <a href="<%= file.file %>" download="<%= file.file.split('/').pop() %>" class="action-btn btn-download">
                <i class="fas fa-download"></i>
                <span>Get</span>
              </a>
              <a href="/file/email/<%= encodeURIComponent(file.file) %>" class="action-btn btn-email">
                <i class="fas fa-envelope"></i>
              </a>
              <a href="/file/delete/<%= file._id %>" class="action-btn btn-delete">
                <i class="fas fa-trash-alt"></i>
              </a>
            </div>
          </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-cloud-upload-alt"></i></div>
            <h3>No files found</h3>
            <p>Upload something to get started!</p>
          </div>
        <% } %>
      </div>

      <div class="action-bar">
        <button class="btn-primary" onclick="document.getElementById('fileInput').click()">
          <i class="fas fa-plus"></i>
          Share Another
        </button>
      </div>

      <!-- Hidden Form for File Upload -->
      <form id="fileForm" action="/file" method="post" enctype="multipart/form-data" class="hidden">
        <input type="file" id="fileInput" name="file" onchange="submitForm()" multiple />
      </form>

      <!-- Modal -->
      <div id="fileModal" class="modal" onclick="closeModal()">
        <div class="modal-content" onclick="event.stopPropagation()">
          <span class="close-modal" onclick="closeModal()">&times;</span>
          <img id="modalImage" src="" alt="File Preview" />
        </div>
      </div>
    </div>

    <footer>
      <p>© 2025 SathiShare. All rights reserved.</p>
    </footer>

    <%- include('component/messageBox') %>

    <script>
      function submitForm() {
        document.getElementById("loadingSpinner").style.display = "flex";
        document.getElementById("fileForm").submit();
      }

      function openPreview(url, fullName) {
        const fileName = fullName.split('/').pop();
        const ext = fileName.includes('.') ? fileName.split('.').pop().toLowerCase() : '';
        const imageExtensions = ["png", "jpg", "jpeg", "gif", "svg", "webp"];
        if (imageExtensions.includes(ext)) {
          const modal = document.getElementById("fileModal");
          const modalImage = document.getElementById("modalImage");
          modalImage.src = url;
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
        } else {
          // Fallback to download for non-previable types
          window.location.href = url;
        }
      }

      function closeModal() {
        document.getElementById("fileModal").style.display = "none";
        document.body.style.overflow = "auto";
      }

      // Show spinner for all link clicks
      document.querySelectorAll("a").forEach(a => {
        if (!a.hasAttribute('download') && a.getAttribute('href') !== '#') {
          a.addEventListener("click", () => {
            document.getElementById("loadingSpinner").style.display = "flex";
          });
        }
      });
    </script>
  </body>
</html>
